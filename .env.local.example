# Minimal local-run profile for the orchestrator.
# Copy to `.env`, fill in the real endpoints for your dev environment, then:
#   az login
#   pip install -e ".[test]"
#   python -m uvicorn main:app --app-dir src --host 127.0.0.1 --port 9000
#
# See docs/local-run.md for the three supported run modes.

LOCAL_MODE=true
allow_environment_variables=true

# Leave APP_CONFIG_ENDPOINT unset to run purely off this file (no Azure App
# Configuration). Set it to also pull shared/base settings from App Config
# (env vars below still take precedence when allow_environment_variables=true).
# APP_CONFIG_ENDPOINT=https://appcs-<uniqueSuffix>.azconfig.io

AGENT_STRATEGY=single_agent_rag
CHAT_DEPLOYMENT_NAME=chat
LOG_LEVEL=INFO

# Azure AI Foundry (chat/completions + agent service)
AI_FOUNDRY_ACCOUNT_ENDPOINT=https://<your-account>.cognitiveservices.azure.com/
AI_FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<projectName>

# Azure AI Search (retrieval backend)
SEARCH_SERVICE_QUERY_ENDPOINT=https://<your-search>.search.windows.net
SEARCH_RAG_INDEX_NAME=ragindex

# Cosmos DB (conversation history)
DATABASE_NAME=<your-cosmos-database-name>
COSMOS_DB_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
CONVERSATIONS_DATABASE_CONTAINER=conversations
DATASOURCES_DATABASE_CONTAINER=datasources

# Optional: only needed if AZURE_CLIENT_ID must target a specific
# user-assigned managed identity (leave unset for local 'az login' use).
# AZURE_CLIENT_ID=
